<Window x:Class="NamakeKaigi.Views.HarnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ツール・許可の設定" Width="640" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13.5"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGreenHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGreenPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" Text="ハーネス(ツール・許可の範囲)の設定" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="HeaderNote" Text="チェックした内容は、保存すると次の発言から効き、settings.json にも保存されます。"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 中身(スクロール可能) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- ===== クローディ(Claude CLI)用パネル ===== -->
                <StackPanel x:Name="ClaudePanel">
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. カードで選ぶ段階" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="カードで選ぶ3つの段階で、できることが決まります。"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="読む" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="ファイルを読んで、検索します。書き換えとコマンドはしません。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="読み書き" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="ファイルの作成・編集もします。コマンドと外部連携は使いません。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="全部" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="コマンドやWebも使います。許可は自動判定で、危ない操作は止まります。外部連携は、下でチェックしたものだけ使います。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 段階ごとの道具・許可コマンドは固定(画面では見せない。settings.json の claude の値を使い、保存しても変えない) -->
                    <StackPanel x:Name="ClaudeDetailPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="1. 「読み書き」のときに使うツール" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="該当するものにチェック (「🤝 サブエージェント呼び出し (Agent)」を入れると、チャットでシラベ等の査読も頼めます)"
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="WriterToolsCheckPanel" HorizontalAlignment="Left"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="その他のツール:" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox x:Name="WriterExtraToolsTextBox" Grid.Column="1" Padding="6,4"
                                             Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                             ToolTip="一覧にないツール(MCPツール名など)をカンマ区切りで追加できます"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="2. 「コマンドも使う」がオンのときに許可するコマンド" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="1行に1つずつ書きます (例: dotnet build* / dotnet test*)。ここに書いたパターン以外のコマンドは自動で拒否されます。"
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="AllowedCommandsTextBox" AcceptsReturn="True" Height="74" Padding="8,6"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="3. 「読む」のときに使うツール" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="「読む」のときに許すツールです。通常は「📄 ファイル読み込み (Read)」だけにしておくと安全で起動も軽くなります。"
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="ReadOnlyToolsCheckPanel" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="2. 「全部」のときに使う外部連携" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="チェックした連携だけを使います。新しく増えた連携は、チェックを入れるまで使いません(メール送信などが、確認なしで動かないように)。「読む」「読み書き」では、連携はいつも使いません。"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ConnectorsStatusText" Text="連携の一覧を取っています…" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="ConnectorsCheckPanel" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== ジェミリー(Gemini = agy)用パネル ===== -->
                <StackPanel x:Name="AgyPanel" Visibility="Collapsed">
                    <!-- Gemini (agy) は道具を1つずつ選べないので、画面で変えるものはない。段階の違いと、外部ツールの足し方だけを説明する
                         (起動引数・添え文は settings.json の agy の値を使う) -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. カードで選ぶ段階" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Gemini は、Claude のように道具を1つずつ選べません。カードで選ぶ3つの段階で、できることが決まります。"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="読む" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="作業フォルダの中のファイルを読みます。書き換えとコマンドはしません。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="読み書き" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="ファイルの作成・編集もします。コマンドと外部ツールは使いません。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="全部" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="ビルド・試験などのコマンドや、外部ツールも、確認なしで使います。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 外部ツール(Google ドライブ・カレンダーなど)を使うには" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Text="Antigravity の Customizations の画面で、使いたいツールの「+」を押して追加してください。追加したツールは、このアプリでは「全部」のときに使えます。"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AgyUpdateBorder" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="2. agy の更新" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="このアプリから起動した agy は、自動では更新しません(更新の確認で、黒い窓が一瞬出るため)。新しい版があるか確かめたいときに押してください。確認の途中で、黒い窓が一瞬出ます。"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AgyUpdateButton" Content="更新を確認" Style="{StaticResource CancelButtonStyle}"
                                        Click="OnCheckAgyUpdate"/>
                                <TextBlock x:Name="AgyUpdateStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== チャッピー(ChatGPT = Codex)用パネル ===== -->
                <StackPanel x:Name="CodexPanel" Visibility="Collapsed">
                    <!-- Codex も道具を1つずつ選べないので、画面で変えるものはない。段階の違いと、モデルの選び方だけを説明する
                         (起動引数・添え文は settings.json の codex の値を使う) -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. カードで選ぶ段階" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="ChatGPT (Codex) は、Claude のように道具を1つずつ選べません。カードで選ぶ3つの段階で、できることが決まります。"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="読む" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="作業フォルダの中のファイルを読みます。書き換えとコマンドはしません。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="読み書き" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="作業フォルダの中のファイルを書き換えます。コマンドも、そのフォルダの中だけ使います(ネット接続なし)。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="全部" FontWeight="SemiBold" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="制限なしです。コマンド・ネット接続・フォルダの外の操作も、確認なしで行います。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="2. モデルと強度" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Text="カードのモデルの欄で選びます。選べるモデルは、起動したときに Codex に聞いて並べます(ChatGPT のプランによって変わります)。「Codexの既定」は、Codex の設定(~/.codex/config.toml)のモデルを使います。強度(思考の深さ)も、カードの欄で選べます。上げるほど考えが深くなり、1回の使用量も増えます。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 下のボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="キャンセル" Style="{StaticResource CancelButtonStyle}" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource SaveButtonStyle}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
