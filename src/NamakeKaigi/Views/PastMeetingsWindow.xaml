<Window x:Class="NamakeKaigi.Views.PastMeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="過去の会議を開く" Width="620" Height="480" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13.5"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGreenHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="過去の会議を開き直して、続きから話す" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="会話IDが保存されている会議はそのまま続きから、IDがない古い会議やCLI側で消えた会議は過去のログを先頭に添えて再開します。"
                       FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusMedium}" Padding="6">
            <Grid>
                <ListBox x:Name="MeetingsList" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="OnListDoubleClick" SelectionChanged="OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,7" Margin="0,2" CornerRadius="8"
                                    Background="{DynamicResource PanelInsetBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource MenuItemHighlightBrush}"
                                            CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ModeBadge}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentGreenBrush}"/>
                                    </Border>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding MeetingNamePrefix}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DisplayTime}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentGreenBrush}"/>
                                            <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="保存されている過去の会議がまだありません。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Style="{StaticResource CancelBtn}" Click="OnCancel" Margin="0,0,8,0"/>
            <Button x:Name="OpenButton" Content="この会議を開く" Style="{StaticResource PrimaryBtn}" Click="OnOpen" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
