<Window x:Class="NamakeKaigi.Views.CliSetupGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ナマケ会議 — AIの準備" Width="620" SizeToContent="Height" MinWidth="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGreenHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20">
        <TextBlock Text="AIのCLIツールがまだ見つかりませんでした" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" LineHeight="20" Margin="0,0,0,14">
            このアプリは、PCに入っている公式の AI CLI ツールを裏で動かします。
            <LineBreak/>
            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Google Antigravity などのアプリ本体を入れただけでは動かない</Run>ため、下のうち<Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">どれか1つ</Run>をターミナル（PowerShell など）でインストールして、ログインを済ませてください。
        </TextBlock>

        <!-- Google Antigravity CLI (agy) -->
        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="1. Google Antigravity CLI（agy / Gemini）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource CopyBtn}" Margin="8,0,0,0"
                            Tag="irm https://antigravity.google/cli/install.ps1 | iex" Click="OnCopyCommand"/>
                    <TextBox IsReadOnly="True" Text="irm https://antigravity.google/cli/install.ps1 | iex"
                             FontFamily="Consolas, Meiryo" FontSize="12" Padding="8,5"
                             Background="{DynamicResource MainBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="PowerShell で実行後、新しいターミナルを開いて agy を実行し、Google ログインしてください。"
                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Claude Code -->
        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="2. Claude Code（Claude）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource CopyBtn}" Margin="8,0,0,0"
                            Tag="npm install -g @anthropic-ai/claude-code" Click="OnCopyCommand"/>
                    <TextBox IsReadOnly="True" Text="npm install -g @anthropic-ai/claude-code"
                             FontFamily="Consolas, Meiryo" FontSize="12" Padding="8,5"
                             Background="{DynamicResource MainBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="Node.js が必要です。導入後、ターミナルで claude を実行してログインしてください。"
                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- OpenAI Codex CLI -->
        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="3. OpenAI Codex CLI（ChatGPT）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource CopyBtn}" Margin="8,0,0,0"
                            Tag="npm install -g @openai/codex" Click="OnCopyCommand"/>
                    <TextBox IsReadOnly="True" Text="npm install -g @openai/codex"
                             FontFamily="Consolas, Meiryo" FontSize="12" Padding="8,5"
                             Background="{DynamicResource MainBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="Node.js が必要です。導入後、ターミナルで codex login を実行してログインしてください。"
                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{DynamicResource AccentGreenBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <DockPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                       Text="入っているのに見つからないときは、起動後に設定の「場所」で指定できます。"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="このまま開く" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnContinueAnyway"/>
                <Button Content="再検出する" Style="{StaticResource PrimaryBtn}" Click="OnRetryDetect"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
