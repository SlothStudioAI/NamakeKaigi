<Window x:Class="NamakeKaigi.Views.RemoteQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スマホでつなぐ" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13.5"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20" Width="320">
        <TextBlock Text="スマホのカメラで読んでください" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="NoteText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <!-- QRコードは白地でないと読みにくいので、配色テーマに関係なく白い台に載せる -->
        <Border Background="White" CornerRadius="12" Padding="10" Margin="0,14,0,0" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBox x:Name="UrlText" Margin="0,14,0,0" IsReadOnly="True" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningTextBrush}"
                   Text="合言葉が入っています。人に見せたり、画面を録画したりしないでください。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="URLをコピー" Click="OnCopy" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
            <Button Content="閉じる" Click="OnClose" Style="{StaticResource SecondaryBtn}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
