<Window x:Class="NamakeKaigi.Views.RosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NamakeKaigi.ViewModels"
        Title="メンバー名簿" Width="920" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13.5"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🦥 メンバー名簿" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="会議には参加しません。誰がいるか、どんな行動ルールかを見るだけの一覧です(定義ファイルは、ここでは書き換えません)。"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: グループごとのメンバー一覧 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="4">
                <TreeView x:Name="RosterTree" ItemsSource="{Binding Groups}" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          SelectedItemChanged="OnSelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:RosterGroupViewModel}" ItemsSource="{Binding Teams}">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Padding="0,3"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:RosterTeamViewModel}" ItemsSource="{Binding Members}">
                            <TextBlock Padding="0,2" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="📁 "/><Run Text="{Binding Header, Mode=OneWay}"/>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:RosterMemberViewModel}">
                            <TextBlock Text="{Binding DisplayName}" Padding="0,2"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!-- 右: 選んだメンバーの詳細と行動ルール -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding DetailTitle}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox Grid.Row="1" x:Name="MetaBox" Text="{Binding DetailMeta, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Text="行動ルール(定義ファイルの本文)" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
                    <TextBox Grid.Row="3" x:Name="RulesBox" Text="{Binding DetailRules, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6"
                             Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 下のボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Style="{StaticResource CloseButtonStyle}" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
