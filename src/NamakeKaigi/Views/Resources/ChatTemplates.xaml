<!-- 発言の見た目: 吹き出し・列の見出しのテンプレートと、発言リストの仮想化(見えている分だけ作る)。
     ボタンのスタイルなどは ControlStyles.xaml のものを使う。 -->
<ResourceDictionary x:Class="NamakeKaigi.Views.ChatTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vm="clr-namespace:NamakeKaigi.ViewModels"
                    xmlns:views="clr-namespace:NamakeKaigi.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ControlStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 発言のリスト: 発言が増えても重くならないよう、見えている分だけ作る(仮想化)。ScrollViewer は ItemsControl のテンプレートの中に置く必要がある。
         中のスクロール部分は名前 PART_Scroll(コードビハインドが、自動スクロールのために取り出す) -->
    <ControlTemplate x:Key="VirtualChatListTemplate" TargetType="ItemsControl">
        <ScrollViewer x:Name="PART_Scroll" VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}"
                      CanContentScroll="True" Focusable="False">
            <ItemsPresenter/>
        </ScrollViewer>
    </ControlTemplate>

    <ItemsPanelTemplate x:Key="VirtualChatPanel">
        <VirtualizingStackPanel/>
    </ItemsPanelTemplate>

    <!-- 吹き出しの最大幅。「別々に見る」の列ではこの値、「まとめて見る」では ChatList の中で広い値に上書きする -->
    <sys:Double x:Key="BubbleMaxWidth">560</sys:Double>

    <!-- 発言1つ分の吹き出し(まとめて見る画面と、別々に見る画面で共用する) -->
    <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
        <DockPanel x:Name="row" Margin="0,7" LastChildFill="True">
            <Grid x:Name="avatar" DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Top">
                <Ellipse Width="40" Height="40"
                         Visibility="{Binding ShowImageAvatar, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUri}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource AccentGreenBrush}"
                        Visibility="{Binding ShowInitialAvatar, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding InitialText}" Foreground="White" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <StackPanel Margin="10,0,10,0">
                <StackPanel x:Name="nameRow" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="8,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <!-- 意見を聞くボタン: 発言者以外のAI1人につき1つ(参加していない人のボタンは出さない) -->
                    <ItemsControl ItemsSource="{Binding AskTargets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnAskOpinion"
                                        Style="{StaticResource LinkButton}" FontSize="11" Margin="10,2,0,0"
                                        Visibility="{Binding CanAsk, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding Tooltip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="🔊" Click="OnSpeakMessage"
                            Style="{StaticResource LinkButton}" FontSize="11" Margin="8,2,0,0"
                            Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="この返答を声で読み上げます(読み上げのスイッチがOFFでも読みます)"/>
                </StackPanel>
                <Border x:Name="bubble" Margin="0,4,0,0" Padding="14,10" BorderThickness="1"
                        HorizontalAlignment="Left" MaxWidth="{DynamicResource BubbleMaxWidth}"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        CornerRadius="{StaticResource CornerRadiusMedium}">
                    <StackPanel>
                        <ContentControl x:Name="body"
                                        views:MarkdownFormatter.Markdown="{Binding Text, Mode=OneWay}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- 返答の途中だけ出す、作業の様子(考え中・読んでいるファイル・作業前のつぶやき) -->
                        <StackPanel Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StatusNote}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding StatusLine}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <!-- 道具を使う前の承認の問い合わせ(一部できるで、許可リストの外の操作をするとき) -->
                        <Border Margin="0,8,0,0" Padding="10,8" BorderThickness="1"
                                BorderBrush="{DynamicResource AccentGreenBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}"
                                Visibility="{Binding HasApproval, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="この操作をしてよいですか？" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ApprovalText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontFamily="Consolas, Meiryo UI"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="許可する" Command="{Binding AllowCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,4"/>
                                    <Button Content="拒否する" Command="{Binding DenyCommand}"
                                            Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
            <!-- あなたの発言: アバターも吹き出しも右寄せ、うす緑 -->
            <DataTrigger Binding="{Binding IsUser}" Value="True">
                <Setter TargetName="avatar" Property="DockPanel.Dock" Value="Right"/>
                <Setter TargetName="nameRow" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="bubble" Property="Background" Value="{DynamicResource MenuItemHighlightBrush}"/>
                <Setter TargetName="bubble" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            </DataTrigger>
            <!-- 返答が流れてくる途中: 吹き出しの枠が緑 -->
            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                <Setter TargetName="bubble" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
            </DataTrigger>
            <!-- 失敗の知らせ: 赤い文字 -->
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter TargetName="body" Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                <Setter TargetName="bubble" Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 別々に見る画面の、列の見出し(アバター・名前・モデル・状態) -->
    <DataTemplate x:Key="ColumnHeaderTemplate" DataType="{x:Type vm:MemberViewModel}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="32" Height="32">
                <Ellipse Width="32" Height="32"
                         Visibility="{Binding ShowImageAvatar, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUri}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="{DynamicResource AccentGreenBrush}"
                        Visibility="{Binding ShowInitialAvatar, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding InitialText}" Foreground="White" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="{Binding ModelText, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
