<Window x:Class="NamakeKaigi.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示名の設定" Width="600" Height="440" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo" FontSize="13.5"
        Icon="pack://application:,,,/NamakeKaigi;component/Assets/namake_icon.png">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGreenHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="表示名の設定" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="画面に出す参加者の名前を変えられます。空欄のときは既定の名前になります。保存すると settings.json にも記憶されます。"
                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="あなたの表示名:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="UserNameBox" Grid.Row="0" Grid.Column="1" Padding="8,5" Margin="0,4"
                                 Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 ToolTip="空欄のときは「あなた」になります"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Claude側の表示名:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="ClaudeNameBox" Grid.Row="1" Grid.Column="1" Padding="8,5" Margin="0,4"
                                 Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 ToolTip="空欄のときは、ふだんは「クローディ」、イラストを頭文字にしているときは「Claude」になります"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gemini側の表示名:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="GeminiNameBox" Grid.Row="2" Grid.Column="1" Padding="8,5" Margin="0,4"
                                 Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 ToolTip="空欄のときは、ふだんは「ジェミリー」、イラストを頭文字にしているときは「Gemini」になります"/>
                    </Grid>
                    <!-- ボタンは入力欄の下に置く(見出しと同じ行に置くと、狭いときに文字と重なるため) -->
                    <Button Content="標準に戻す" Style="{StaticResource SecondaryBtn}" FontSize="11.5" Padding="10,3"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Click="OnResetDefaultPreset" ToolTip="名前を空欄に戻します(既定の名前になります)"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Style="{StaticResource SecondaryBtn}" Click="OnCancel" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryBtn}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
