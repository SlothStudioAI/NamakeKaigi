<!-- 森テーマの共有リソース(アプリ全体で共有)。配色ブラシ・角丸・スクロールバー・ツールチップ・メニューを定義する。
     App.xaml の MergedDictionaries で読み込むため、メイン画面・サポート・各ポップアップから同じキーで参照できる。
     色・角丸の変更は、このファイルだけで行う。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ===== 角丸の大きさ(柔らかい森の印象。丸みの調整はここだけで行う) =====
             ウィンドウ自体の外形の角丸はWindows 11のDWMが描く(MainWindow.xaml.csのWindowCornerPreference定数)。
             メンバー/リーダーカードの角丸はコードビハインド側の定数(CardCornerRadius / LeaderCardCornerRadius)で指定する。 -->
        <!-- 小: ＋ボタン、キャプションボタンのホバー面、メニュー項目 -->
        <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
        <!-- 中: ヘッダーボタン、警告枠、ツールチップ、メニュー、トースト、サイドバー項目 -->
        <CornerRadius x:Key="CornerRadiusMedium">14</CornerRadius>
        <!-- 大: TEAM/WORKSPACEパネル、空状態、ウェルカムパネル -->
        <CornerRadius x:Key="CornerRadiusLarge">20</CornerRadius>
        <!-- ピル: 両端が完全な半円になる(バッジ、検索ボックス、切替ピル、スクロールバーのつまみ) -->
        <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

        <!-- ===== 配色リソース(森イメージ: 明るい緑サイドバー+薄い黄色背景+薄クリームのパネル)。色の変更はここだけで行う ===== -->
        <!-- 左サイドバーの背景(明るめの森の緑) -->
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#2F6B45"/>
        <!-- サイドバーの区切り線・枠線 -->
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#4C8A63"/>
        <!-- サイドバー項目のホバー背景 -->
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#35704A"/>
        <!-- サイドバー項目の選択中背景 -->
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3B7D52"/>
        <!-- サイドバー内のドロップダウン背景 -->
        <SolidColorBrush x:Key="SidebarInputBackgroundBrush" Color="#255436"/>
        <!-- サイドバーの通常文字(淡いクリームグリーン。背景に対し約5.9:1) -->
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#F2F8EE"/>
        <!-- サイドバーの見出し・補助文字 -->
        <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#CFE3CF"/>
        <!-- サイドバーのアクセント(アイコン等) -->
        <SolidColorBrush x:Key="SidebarAccentBrush" Color="#D9F28A"/>
        <!-- サイドバーのロゴ丸の背景 -->
        <SolidColorBrush x:Key="SidebarLogoBrush" Color="#6DB67F"/>
        <!-- メイン画面の背景(薄い黄色。カード領域の地色) -->
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FBF6DC"/>
        <!-- ヘッダー・TEAM/WORKSPACEパネル・空状態など、黄色背景の上に乗る薄いクリーム色の面 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFCEF"/>
        <!-- パネルの枠線(淡いグレー) -->
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0"/>

        <!-- ===== タイトルバー(サイドバーの緑とつながる緑系)。色・高さの変更はここだけで行う ===== -->
        <!-- タイトルバーの高さ(WindowChrome.CaptionHeightと同じ値にすること) -->
        <GridLength x:Key="TitleBarHeight">38</GridLength>
        <!-- タイトルバー背景: サイドバーと同じ単色(SidebarBackgroundBrushを直接参照する。専用ブラシは持たない) -->
        <!-- タイトルバー下端の区切り線(サイドバーの区切り線SidebarBorderBrushと同じ色) -->
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#4C8A63"/>
        <!-- タイトル文字(淡いクリーム白) -->
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F7FBF1"/>
        <!-- キャプションボタンの通常アイコン色 -->
        <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#F2F8EE"/>
        <!-- キャプションボタンのホバー背景(明るい緑) -->
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3B7D52"/>
        <!-- キャプションボタンの押下背景 -->
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#1F4D32"/>
        <!-- 閉じるボタンのホバー/押下背景(赤系) -->
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C94242"/>
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#A83333"/>

        <!-- ===== ポップアップ(設定・ルール・メンバー編集など)向けの追加リソース ===== -->
        <!-- タブ見出しの角丸(上側だけ丸い) -->
        <CornerRadius x:Key="CornerRadiusTab">12,12,0,0</CornerRadius>
        <!-- 本文の標準文字色(濃い茶。サポート画面の本文と同じ) -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3B2A1E"/>
        <!-- 補助説明の文字色(落ち着いた緑グレー。クリーム背景に対し約4.6:1) -->
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7762"/>
        <!-- 見出し・強調・リンクの緑 -->
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2F6B45"/>
        <SolidColorBrush x:Key="LinkTextBrush" Color="#2F6B45"/>
        <!-- 主ボタン(緑)のホバー/押下 -->
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#265A39"/>
        <SolidColorBrush x:Key="AccentGreenPressedBrush" Color="#1F4D32"/>
        <!-- 入力欄の背景・枠線・フォーカス枠 -->
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D5DCC8"/>
        <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#2F6B45"/>
        <!-- 副ボタン(キャンセル等)の背景。クリーム+枠線 -->
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#FFFCEF"/>
        <!-- パネルの中のくぼみ(読み取り専用欄・情報帯)の背景。パネルより少し濃いクリーム -->
        <SolidColorBrush x:Key="PanelInsetBrush" Color="#F4F1DA"/>
        <!-- ルール編集欄(コード風エディタ)の背景と文字。深い森の緑 -->
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#23382B"/>
        <SolidColorBrush x:Key="EditorForegroundBrush" Color="#F2F8EE"/>
        <!-- 警告の文字色(取消・エラー系)と成功の文字色 -->
        <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#C94242"/>

        <!-- ===== 入力欄(全画面のTextBox共通)。ダークでも文字・カーソル・選択範囲が見えるよう、テーマの色に合わせる。
             各画面で個別に指定した値(ローカル値)は、こちらより優先される。
             Styleの中の色は最初に使った時点で固定されるため、テーマの切り替えに追従するよう DynamicResource で参照する ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>

        <!-- チェックボックスの文字色もテーマに追従させる(標準の見た目は黒の文字色を自分で持ち、親の色を受け継がないため) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- リストボックスの文字色もテーマに追従させる(標準のListBoxItemは黒の文字色を自分で持ち、親の色を受け継がないため) -->
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===== ポップアップの角丸スタイル ===== -->
        <!-- 淡い緑グレー(ボタン押下時の背景に使う) -->
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B8C7B0"/>

        <!-- ===== スクロールバー(全画面共通)。溝は透明、つまみは細い角丸。
             標準の見た目(明るい灰色)はダークのテーマで浮くため、テーマの色に合わせる。
             色は各テーマにある枠線の色(通常)と補助文字の色(ホバー・ドラッグ中)を DynamicResource で使い、テーマの切り替えに付いてくる ===== -->
        <!-- 溝の中の空き(押すとページ送り。見た目は透明) -->
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- つまみ(両端が半円) -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="{DynamicResource PopupBorderBrush}" CornerRadius="{StaticResource CornerRadiusPill}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 縦。溝の幅は標準のまま(並びの計算を変えない)、つまみだけ細くする -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="4,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <!-- 横 -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="2,4"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ツールチップ・メニューの枠線色 -->
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#D5DCC8"/>
        <!-- メニュー項目のホバー背景(淡い緑) -->
        <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#E6EFD8"/>

        <!-- ツールチップ(サイドバーのパス表示・メンバー追従ポップアップ共通)。角丸の淡いクリーム色の面 -->
        <Style x:Key="RoundedToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource RoundedToolTipStyle}"/>

        <!-- 右クリックメニュー/通知メニュー(コードビハインドのApplyRoundedMenuStyleで各項目にも適用する) -->
        <Style x:Key="RoundedContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- メニュー項目(ホバーで淡い緑の角丸ハイライト) -->
        <Style x:Key="RoundedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="12,6" MinWidth="160">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource MenuItemHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="itemBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- メニューの区切り線 -->
        <Style x:Key="RoundedMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource PopupBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
